{
  "skill": "impasto-tween-animation",
  "version": "2.0.0",
  "upstream": "palette-knife-impasto-ui",
  "runtime": "h5-dom",
  "input": "mixed",
  "states": ["default", "hover", "focus-visible", "pressed", "clicked", "disabled", "selected", "loading", "success", "error"],
  "stateMachine": {
    "path": ["default", "hover|focus-visible", "pressed", "clicked", "loading", "success|error", "default"],
    "priority": {"default": 0, "hover": 1, "focus-visible": 1, "pressed": 2, "clicked": 2, "success": 3, "error": 3, "loading": 4, "disabled": 5},
    "interrupt": ["pointercancel", "blur", "pointerleave", "disabled"],
    "recovery": "cancel active handle, preserve current visual value, then enter the next state"
  },
  "tokens": {
    "ease-standard": {"css": "cubic-bezier(.2,0,0,1)", "godot": {"transition": "TRANS_CUBIC", "ease": "EASE_OUT", "durationSec": 0.18}},
    "ease-enter": {"css": "cubic-bezier(.16,1,.3,1)", "godot": {"transition": "TRANS_QUART", "ease": "EASE_OUT", "durationSec": 0.32}},
    "ease-juice": {"css": "cubic-bezier(.22,1.25,.36,1)", "godot": {"transition": "TRANS_BACK", "ease": "EASE_OUT", "durationSec": 0.36}},
    "ease-jelly": {"css": "cubic-bezier(.35,1.5,.65,1)", "godot": {"transition": "TRANS_ELASTIC", "ease": "EASE_OUT", "durationSec": 0.44}},
    "ease-step": {"css": "steps(4,end)", "godot": {"transition": "TRANS_STEP", "ease": "EASE_IN_OUT", "durationSec": 0.28}},
    "ease-linear": {"css": "linear", "godot": {"transition": "TRANS_LINEAR", "ease": "EASE_IN_OUT", "durationSec": 0.7}}
  },
  "attributeWhitelist": {
    "geometry": ["transform", "transform-origin", "opacity"],
    "material": ["opacity", "filter", "background-position", "clip-path"],
    "semantic": ["outline", "color", "icon.transform"]
  },
  "pointerReactive": {"maxOffsetPx": 6, "speedThresholdPxPerSec": 2200, "touchFallback": "pressed/selected", "clearOn": ["pointercancel", "pointerleave", "blur"], "reducedMotion": "disabled"},
  "motionBudget": {"feedbackMs": [120, 220], "enterMs": [220, 420], "exitMs": [140, 240], "maxRecipeMs": 520, "touchTargetMinPx": 44},
  "components": [
    {"id":"hero-cta","source":"button","states":["default","hover","focus-visible","pressed","clicked","loading","success","error","disabled"],"materialInvariant":["paintTexture","knifeEdge","textSafeZone"],"channels":{"geometry":".button-geometry","material":".button-sheen","semantic":".button-copy"},"feedback":"juice","pointerReactive":true},
    {"id":"state-tiles","source":"button-grid","states":["default","hover","focus-visible","pressed","clicked","disabled","selected","loading","success","error"],"materialInvariant":["paintTexture","highlight","textSafeZone"],"feedback":"state-sampler"},
    {"id":"easing-lab","source":"button","states":["default","hover","pressed","clicked"],"materialInvariant":["paintTexture","textSafeZone"],"feedback":"easing-switch"},
    {"id":"recipe-stage","source":"recipe-catalog","recipes":["background-slide","border-spread","pseudo-wipe","icon-shift","local-sheen","magnetic-follow"],"materialInvariant":["paintTexture","knifeEdge","textSafeZone"]}
  ],
  "reducedMotion": {"system":"prefers-reduced-motion: reduce","manualToggle":true,"fallback":"instant state + focus/contrast/text"},
  "qa": {"desktop":"self-checkable","mobile":"44px + touch fallback","nodeCheck":"passed","jsonParse":"passed","fps":"runtime sample"}
}
